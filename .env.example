APP_NAME=Educlass
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=educlass
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@educlass.com"
MAIL_FROM_NAME="${APP_NAME}"

WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=57

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Configuración específica de Educlass
EDUCLASS_INTENTOS_DEFAULT=5
EDUCLASS_UMBRAL_APROBACION=60
EDUCLASS_ANIO_ACADEMICO=2025
EDUCLASS_PERIODO_ACTUAL=1

# Configuración de gamificación
GAMIFICACION_PUNTOS_BASE=100
GAMIFICACION_BONIFICACION_TIEMPO=true
GAMIFICACION_RACHA_BONUS=10

# Configuración de juegos
JUEGOS_TIMER_DEFAULT=300
JUEGOS_MEMORIA_PARES=8
JUEGOS_SOPA_TAMANO=15
